{
  "name": "relationship-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Relationship Manager — a multi-user PWA that imports your LinkedIn, Facebook, X, contacts and bidirectional email threads and lets you explore them as personal, business, corporate and social networks.",
  "license": "MIT",
  "repository": "https://github.com/RealityCramp/Relationship-Manager",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'shared/src/**/*.test.ts' 'server/src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "node --import tsx server/src/seed.ts",
    "training:record": "node --import tsx training/record.ts",
    "training:build": "node --import tsx training/build.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.56.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
